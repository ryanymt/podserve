# Terraform local cache, state (stored in GCS), variable files, and crash logs.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Built CLI binary.
/podserve
/bin/

# Generated by `terraform output -json` during quickstart.
/platform.json

# Python bytecode cache.
__pycache__/
*.py[cod]

# Editor and OS files.
.DS_Store
